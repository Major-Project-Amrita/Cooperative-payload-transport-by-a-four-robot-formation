<?xml version="1.0" ?>
<!--
  swarm_world_rand02.sdf - RANDOMISED LAYOUT #2 (30 m x 16 m), generated by
  make_random_worlds.py with seed 1002. 14 compact obstacles placed
  uniformly at random subject to: clear start ring and goal pad, corridor
