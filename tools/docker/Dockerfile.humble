# ROS 2 Humble + the package's Python dependencies, for tools/ros_humble_full.sh
#   docker build -t swarm-humble -f tools/docker/Dockerfile.humble tools/docker
# Behind a TLS-intercepting proxy, copy its CA certificate to tools/docker/extra-ca.crt
# first (it is added to the trust store if present).
FROM ros:humble-ros-base
COPY . /tmp/ctx
RUN if [ -f /tmp/ctx/extra-ca.crt ]; then cp /tmp/ctx/extra-ca.crt /usr/local/share/ca-certificates/ \
    && update-ca-certificates; fi
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip \
      ros-humble-visualization-msgs ros-humble-nav-msgs ros-humble-rosgraph-msgs \
      libgl1 libegl1 libosmesa6 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir "numpy<2" scipy mujoco pytest matplotlib
